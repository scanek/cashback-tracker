{
  "expo": {
    "name": "Мои Кэшбеки",
    "slug": "scanek_dev",
    "version": "1.7.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cashbackhub.app"
    },
    "android": {
      "package": "com.cashbackhub.app",
      "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CashbackWidget",
              "label": "Мои Кэшбеки",
              "minWidth": "300dp",
              "minHeight": "200dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "650dp",
              "resizeMode": "horizontal|vertical",
              "description": "Виджет всех категорий кэшбэка банков на месяц",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "54c34851-5a10-4769-bd80-5fd0d8f577e4"
      },
      "author": "Александр Щеголев"
    },
    "owner": "scanek_dev"
  }
}
